{
  "name": "lotto-generater-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Lotto number generator for unlucky people",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.4",
    "typescript": "^5.6.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
